#!/usr/bin/env bash
# 푸시 전 검수 훅 — 여섯 겹이다. (머리말이 "두 겹" 이라고 적혀 있던 것을 2026-08-13 에 고쳤다 —
# 코드에는 여섯 개가 있는데 여기는 둘, CLAUDE.md 는 셋이라고 적고 있었다.)
#
#   0겹   · 배포 쿨다운 — 직전 푸시 직후의 연속 푸시를 막는다 (아래 상세)
#   1겹   · 결과물 공통 점검 (page-audit.mjs) — 모든 푸시
#           저장소의 모든 *.html + CNAME + assets 를 본다. 새 페이지를 추가해도
#           설정을 고칠 필요 없이 자동으로 대상에 들어온다.
#   1.2겹 · 피그마 트리 점검 (tree-audit.mjs) — 모든 푸시. 섹션 밖 고아 노드
#   1.5겹 · 온보딩 직군 목록 ↔ taxonomy.json (roles/build.mjs --check) — 모든 푸시
#   2겹a  · 약관·개인정보·가입·온보딩 문구 대조 (docs-audit.mjs) — *.html 이 바뀐 푸시
#   2겹b  · 랜딩 피그마 대조 (audit.mjs) — index.html / assets 가 바뀐 푸시
#           기준 프레임(6:148)이 있는 랜딩만 해당.
#
#   🔴 1~2겹은 전부 **node 로 돈다.** node 가 없는 PC 에서는 막지 않고 건너뛴다(아래 HAVE_NODE).
#      같은 검수가 .github/workflows/landing-audit.yml 에서 리눅스로 다시 돈다.
#
#   🔴 피그마 덤프는 **셋 다 사실상 필수**다. 훅은 figma_meta.xml 만 없을 때 막지만,
#      audit.mjs 가 TYPE·STYLE 을 findings 로 올리고 그 등급들로 종료코드 1 을 낸다.
#      "없어도 경고만" 이 아니다.
#
# 설치 (클론한 세션에서 한 줄):
#   git config core.hooksPath tools/hooks
#
# 피그마 덤프 세 개를 찾는 순서:
#   1) 환경변수 FIGMA_META / FIGMA_TYPE / FIGMA_STYLE
#   2) 저장소 루트의 figma_meta.xml / figma_type.json / figma_style.json
#   3) 상위 디렉터리(/home/claude 등)의 같은 이름 파일
#
# 급할 때만: git push --no-verify

set -u
ROOT="$(git rev-parse --show-toplevel)"
# 🔴 예전에는 `|| exit 0` 이었다. 그러면 여기서 실패했을 때 **출력 한 줄 없이 6겹 전부**
#    건너뛰고 푸시가 나간다 — "검사가 안 돈 것" 이 "통과" 로 보인다(2026-08-13 재현).
# `cd ""` 는 bash 에서 **성공한다**(제자리에 머문다). 빈 값도 실패로 본다 — 안 그러면
# ROOT="" 로 아래 덤프 탐색이 `/figma_meta.xml` 같은 루트 경로를 뒤진다(검사관 지적).
[ -n "$ROOT" ] && cd "$ROOT" || {
  echo "✋ 푸시 중단 — 저장소 루트를 못 찾았습니다 ('$ROOT'). 검수를 하나도 못 돌렸습니다." >&2
  exit 1
}

# ── 환경 판정은 tools/doctor.sh 한 곳에서 한다 (2026-08-13) ──────────
# 전에는 이 훅과 career-coach 훅이 **같은 것을 다르게** 봤다. 판정을 한 파일로 모았다.
# 그 파일은 두 저장소에 같은 내용으로 있다 — 한쪽을 고치면 다른 쪽도 고친다.
#   보고서로 보려면: bash tools/doctor.sh
#
# 이 훅의 검수 5종은 전부 node 로 돈다. 그런데 **사용자 PC 3대에 node 가 없을 수 있다**
# (2026-08-11 실측: DESKTOP-F7S1OEL 에 없음 — 정본은 career-coach
#  docs/기획/피그마-웹-동기화.md 「랜딩 pre-push 훅은 node 를 쓴다」).
#
# 전에는 가드가 없어서 node 가 없으면 `node …` 가 127 로 죽고, 훅이 그것을 검수 실패로 읽어
# **"깨진 링크·빠진 head·자리표시자" 라는 엉뚱한 진단**으로 푸시를 막았다. 이 저장소 훅에는
# career-coach 의 CC_SKIP_HOOK 같은 부분 우회가 없어서, 빠져나갈 길이 `--no-verify`
# = **6겹 전부 끄기** 하나뿐이었다. 엄격한 규칙이 우회를 부르면 검사량이 오히려 준다.
#
# 그래서 node 가 없으면 **막지 않고 무엇을 못 봤는지 말한다.** 같은 검수 5종이
# .github/workflows/landing-audit.yml 에서 리눅스로 다시 돈다 — 놓치는 것이 아니라 옮기는 것이다.
# shellcheck source=tools/doctor.sh
. "$ROOT/tools/doctor.sh"
dr_probe
dr_line >&2

DONE_MSG="✅ 검수 통과 — 푸시합니다."
if [ -n "$DR_NODE" ]; then
  HAVE_NODE=1
else
  DONE_MSG="✅ 검수 통과(부분 — node 가 없어 이 PC 에서는 검수를 못 돌렸습니다. 셋은 CI 가, 피그마 대조 둘은 아무도 안 봅니다) — 푸시합니다."
  HAVE_NODE=0
  echo "   → index.html/assets 를 고쳤다면 node 가 있는 곳에서 피그마 대조를 한 번 돌리고 미세요." >&2
fi

fail() {
  cat >&2
  echo "(정말 급하면: git push --no-verify — 다만 그러면 6겹이 통째로 꺼집니다)" >&2
  exit 1
}

# ───────────────────────────────────────────────────
# 0겹 — 배포 쿨다운 (연속 푸시로 앞 배포를 죽이지 않도록)
#
# GitHub Pages 는 [푸시 → 빌드 → 배포] 3단계고, 같은 브랜치에 새 푸시가 들어오면
# 진행 중이던 실행을 "higher priority waiting request" 로 **취소**한다.
# 2026-08-02 에 30분 동안 다섯 번 푸시했더니 앞의 네 개가 전부 취소돼,
# 이미 고친 버그가 라이브에 한 시간 넘게 안 올라갔다.
#
# 그래서 직전 푸시로부터 CC_PUSH_COOLDOWN 초가 지나기 전에는 푸시를 막는다.
# "직전 푸시 시각" 은 origin/main 최신 커밋의 커밋 시각으로 근사한다(세션이 달라도 통한다).
#
#   조절:  CC_PUSH_COOLDOWN=<초> git push …    (0 이면 쿨다운만 끔, 검수는 그대로 돈다)
#   기본:  900초(15분)
# ───────────────────────────────────────────────────
COOLDOWN="${CC_PUSH_COOLDOWN:-900}"
# 🔴 숫자가 아니면 `[ -gt ]` 가 오류를 내고 2>/dev/null 이 그것을 먹어, **늘리려던 사람이
#    쿨다운을 끄게 된다**(`CC_PUSH_COOLDOWN=15m` 으로 2026-08-13 재현). 조용히 넘어가지 않는다.
# 자릿수까지 본다 — 전부 숫자여도 int64 를 넘으면 `[ -gt ]` 가 다시 rc=2 로 조용히 꺼진다.
case "$COOLDOWN" in
  ''|*[!0-9]*|??????????*)
    echo "⚪ CC_PUSH_COOLDOWN 값이 쓸 수 있는 초가 아닙니다: '$COOLDOWN' → 기본값 900 을 씁니다." >&2
    COOLDOWN=900
    ;;
esac
if [ "$COOLDOWN" -gt 0 ]; then
  # 브레이크 둘. 이 fetch 가 자격증명을 물으면 Git Credential Manager 가 **화면 밖에
  # 창을 띄우고 무한정 매달린다** — 사용자의 `git push` 가 아무 출력 없이 멈춘다.
  # 2026-08-10 에 career-coach 쪽에서 같은 형태가 11.9시간 매달렸다(계정 고정이
  # 걸린 PC 에서도 났다). 접두형을 쓸 수 있는 것은 이 파일이 **항상 bash 로 돌기**
  # 때문이다(상시 규칙이 접두형을 금지한 이유는 cmd·PowerShell 함정이다).
  #
  # 둘이 막는 것이 다르다. 넘겨짚지 않고 아는 것만 적는다.
  #   · GIT_TERMINAL_PROMPT=0        git **본체**의 터미널 프롬프트를 닫는다.
  #                                  자격증명 **헬퍼**(GCM)의 GUI 창은 못 닫는다.
  #   · credential.interactive=false GCM 의 GUI·TTY 를 닫는다. git 본체가 이 키를
  #                                  아는 것은 2.47+ 다. 그 미만에서 `-c` 값이
  #                                  헬퍼까지 닿는지는 **확인하지 못했다** — 내가
  #                                  닿을 수 있는 환경에 GCM 이 없다.
  # 잰 PC 는 2대(git 2.54·2.55)로 둘 다 2.47 이상이고, 나머지 1대는 미측정이다.
  # 그 1대가 2.47 미만이면 이 두 줄로도 GCM GUI 는 못 막는다 — 그때는 규칙 2)의
  # 계정 고정과 원격 URL 점검이 먼저다.
  #
  # 갱신에 실패해도 **로컬에 남은 origin/main 으로 그대로 판정한다.** 버리지 않는다 —
  # `git push` 는 성공하면 스스로 `refs/remotes/origin/main` 을 갱신하므로, 이 훅이
  # 가장 막고 싶은 경우(같은 클론에서 몇 분 뒤 재푸시)의 로컬 ref 는 **정확하다.**
  # 자격증명이 필요한 PC 에서는 이 fetch 가 매번 실패하는데, 실패했다고 판정을 버리면
  # 그 PC 에서 0겹이 **영구히 꺼진다**(검사관 지적, 2026-08-10 재현).
  # 안전 방향도 한쪽뿐이다 — 낡은 ref 는 ELAPSED 를 **크게만** 만든다. 즉 헛막음은
  # 만들 수 없고 놓침만 만든다. 그래서 판정은 살리고 **못 갱신했다는 사실만 띄운다.**
  COOLDOWN_STALE=""
  if ! GIT_TERMINAL_PROMPT=0 git -c credential.interactive=false \
         fetch -q origin main 2>/dev/null; then
    COOLDOWN_STALE=1
  fi
  LAST="$(git log -1 --format=%ct origin/main 2>/dev/null || echo '')"

  if [ -z "$LAST" ]; then
    # ref 자체가 없다 — 잴 것이 없다. 막지는 않되(오탐으로 푸시가 통째로 막히는 쪽이
    # 더 비싸다, 2026-08-09 사용자 결정) 조용히 넘어가지도 않는다.
    {
      echo ""
      echo "⚪ 배포 쿨다운을 못 쟀습니다 — origin/main 참조가 없습니다."
      echo "   직전 푸시로부터 $(( COOLDOWN / 60 ))분이 지났는지 **모른 채** 푸시합니다."
      echo ""
    } >&2
  elif [ -n "$COOLDOWN_STALE" ]; then
    {
      echo ""
      echo "⚪ origin/main 을 갱신하지 못했습니다 (네트워크·자격증명)."
      echo "   아래 판정은 로컬에 남은 origin/main 기준이라 **실제보다 느슨할 수 있습니다**"
      echo "   (다른 세션이 그 사이 민 것은 안 보입니다). 막는 쪽으로는 틀리지 않습니다."
      echo "   확인(이 형태 그대로 — 브레이크를 빼면 그 자리에서 매달릴 수 있습니다):"
      echo "     GIT_TERMINAL_PROMPT=0 git -c credential.interactive=false fetch origin main"
      echo ""
    } >&2
  fi

  if [ -n "$LAST" ]; then
    NOW="$(date +%s)"
    ELAPSED=$(( NOW - LAST ))
    if [ "$ELAPSED" -ge 0 ] && [ "$ELAPSED" -lt "$COOLDOWN" ]; then
      WAIT=$(( COOLDOWN - ELAPSED ))
      {
        echo ""
        echo "✋ 푸시 중단 — 직전 푸시가 $(( ELAPSED / 60 ))분 $(( ELAPSED % 60 ))초 전입니다."
        echo ""
        echo "GitHub Pages 배포가 아직 진행 중일 수 있습니다. 지금 푸시하면 그 배포가"
        echo "취소되고(higher priority waiting request) 큐를 처음부터 다시 탑니다."
        echo "결과적으로 라이브 반영이 더 늦어집니다."
        echo ""
        echo "  → 약 $(( (WAIT + 59) / 60 ))분 뒤에 다시 푸시하세요 (쿨다운 $(( COOLDOWN / 60 ))분)."
        echo "  → 그동안 커밋을 더 쌓아 두면 한 번에 나갑니다 (그게 가장 빠릅니다)."
        echo "  → 확인만 급하면 미리보기로: node tools/make-preview.mjs"
        echo ""
        echo "정말 지금 나가야 하면 (검수는 그대로 돕니다):"
        echo "  CC_PUSH_COOLDOWN=0 git push origin main"
        echo ""
      } >&2
      exit 1
    fi
  fi
fi

# ───────────────────────────────────────────────────
# 1겹 — 결과물 공통 점검 (항상)
# ───────────────────────────────────────────────────
if [ "$HAVE_NODE" = "1" ]; then
echo "▶ 결과물 공통 점검…"
if ! node tools/figma-audit/page-audit.mjs; then
  fail <<'MSG'

✋ 푸시 중단 — 결과물 공통 점검에서 조치 필요 항목이 나왔습니다.
깨진 링크·빠진 head·자리표시자·태그 불균형은 배포되면 바로 드러납니다.
위 "❌ 막힘" 항목을 고친 뒤 다시 푸시하세요.
MSG
fi
fi

# ───────────────────────────────────────────────────
# 1.2겹 — 피그마 트리 점검 (tree-audit.mjs) — node 가 있으면 항상 돈다
#
#   "섹션 밖으로 튀어나간 고아 노드" 를 잡는 유일한 검사다.
#   2026-08-08 에 프레임 626:2657 이 섹션 625:2657 밖으로 나가 캔버스에 떠 있었는데
#   검수 여섯 종이 전부 통과했다 — 나머지는 방향이 '웹 → 피그마' 이거나 프레임 안쪽만 본다.
#
#   덤프 없이도 돈다(스냅샷 자체 정합성). 라이브 고아 노드까지 보려면
#   figma_tree.json 을 준다 — 찾는 순서는 아래 2겹의 덤프와 같다.
#   등록부나 트리 스냅샷을 건드린 푸시에는 덤프를 **요구**한다(그때가 어긋나기 제일 쉬운 순간이라).
#
#   섹션이 늘거나 이름이 바뀌어 스냅샷이 낡은 것은 **막지 않는다** — `↺ 스냅샷 낡음` 으로만
#   찍고, `--update` 한 줄이면 맞는다. 예약 점검이 매일 그 한 줄을 대신 돌려 커밋한다.
# ───────────────────────────────────────────────────
[ "$HAVE_NODE" = "1" ] && echo "▶ 피그마 트리 점검 (고아 노드)…"
TREE=""
for p in "${FIGMA_TREE:-}" "$ROOT/figma_tree.json" "$ROOT/../figma_tree.json" "$HOME/figma_tree.json"; do
  [ -n "$p" ] && [ -f "$p" ] && { TREE="$p"; break; }
done

TREE_BASE="$(git rev-parse --verify -q origin/main 2>/dev/null || echo '')"
if [ -n "$TREE_BASE" ]; then
  CHANGED_TREE="$(git diff --name-only "$TREE_BASE"..HEAD -- tools/figma-audit/page-figma-map.json tools/figma-audit/figma-tree.json 2>/dev/null)"
else
  CHANGED_TREE="unknown"
fi

if [ "$HAVE_NODE" = "1" ] && [ -z "$TREE" ] && [ -n "$CHANGED_TREE" ]; then
  fail <<'MSG'

✋ 푸시 중단 — 피그마 등록부/트리 스냅샷을 바꿨는데 라이브 피그마와 대조하지 않았습니다.

tools/figma-audit/README.md "피그마 트리 덤프" 스니펫을 use_figma 로 돌려
figma_tree.json 으로 저장한 뒤 다시 푸시하세요. (섹션 밖으로 나간 노드를 여기서 잡습니다)
MSG
fi

if [ "$HAVE_NODE" = "1" ] && ! node tools/figma-audit/tree-audit.mjs ${TREE:+"$TREE"}; then
  fail <<'MSG'

✋ 푸시 중단 — 피그마 안에서 노드가 섹션 밖으로 나갔습니다.
위 "❌ 막힘" 을 피그마에서 되돌린 뒤(섹션 안으로 옮기기) 다시 푸시하세요.
("↺ 스냅샷 낡음" 은 막지 않습니다 — 그건 --update 한 줄로 맞습니다.)
섹션의 자식은 x/y 가 섹션 기준 상대좌표입니다 — 좌표만 맞추고 부모를 확인하지 않으면
숫자는 맞는데 캔버스 저편에 떠 있는 상태가 됩니다.
MSG
fi

# ───────────────────────────────────────────────────
# 1.5겹 — 온보딩 직군 목록이 taxonomy.json 에서 생성된 그대로인가
#   손으로 고치면 code(직행 조회 표기)와 label(화면 표기)이 조용히 어긋난다.
# ───────────────────────────────────────────────────
if [ "$HAVE_NODE" = "1" ]; then
echo "▶ 온보딩 직군 목록 ↔ taxonomy.json 대조…"
if ! node tools/roles/build.mjs --check; then
  fail <<'MSG'

✋ 푸시 중단 — 온보딩 1단계 직군 목록이 tools/roles/taxonomy.json 과 다릅니다.
목록은 taxonomy.json 이 기준이고 HTML 은 파생물입니다.
  node tools/roles/build.mjs
를 돌려 다시 만든 뒤 커밋하세요. (문구·분류를 바꾸려면 taxonomy.json 을 고칩니다)
MSG
fi
fi

# ───────────────────────────────────────────────────
# 2겹 — 피그마 대조
#   (a) 약관·개인정보 화면 (docs-audit.mjs) — terms/privacy.html 또는 스냅샷이 바뀐 푸시.
#       커밋된 스냅샷(figma-docs-text.json)과 문구를 대조하므로 라이브 피그마 덤프가 필요 없다.
#   (b) 랜딩 (audit.mjs) — index.html/assets 가 바뀐 푸시. 피그마 덤프 3개가 필요하다.
# ───────────────────────────────────────────────────
RANGE_BASE="$(git rev-parse --verify -q origin/main 2>/dev/null || echo '')"
diff_names() {
  if [ -n "$RANGE_BASE" ]; then git diff --name-only "$RANGE_BASE"..HEAD -- "$@" 2>/dev/null
  else printf '%s\n' "$@"; fi   # origin/main 을 모르면 안전하게 '바뀐 것'으로 취급
}

# (a) 문서·가입·온보딩 화면 ↔ 피그마 문구 동기화
#   대상 파일을 손으로 나열하지 않는다 — 2026-08-07 에 그 목록이 낡아서
#   signup/onboarding 이 대조 대상에서 빠져 있었다(같은 종류의 사고가 두 번 났다).
#   HTML 이 하나라도 바뀌었으면 돌린다. 브라우저·피그마 덤프가 필요 없어 싸다.
CHANGED_DOCS="$(diff_names '*.html' tools/figma-audit/figma-docs-text.json tools/figma-audit/page-figma-map.json)"
if [ -n "$CHANGED_DOCS" ]; then
  [ "$HAVE_NODE" = "1" ] && echo "▶ 약관·개인정보 화면 ↔ 피그마 문구 대조…"
  if [ "$HAVE_NODE" = "1" ] && ! node tools/figma-audit/docs-audit.mjs; then
    fail <<'MSG'

✋ 푸시 중단 — 약관·개인정보 화면이 피그마와 어긋났습니다.
웹과 피그마 중 한쪽만 문구를 고치면 납니다.
  · 웹을 고쳤으면 → 피그마 화면(섹션 327:2474)도 같은 문구로 고치고, 스냅샷을 다시 뽑아 커밋하세요.
  · 피그마를 고쳤으면 → 웹(terms/privacy.html)을 맞추고, 스냅샷을 다시 뽑아 커밋하세요.
스냅샷 다시 뽑기: CLAUDE.md "약관·개인정보 화면 — 피그마↔웹 동기화" 참고.
MSG
  fi
fi

# (b) 랜딩 대조 (index.html/assets 가 바뀐 푸시만)
CHANGED_LANDING="$(diff_names index.html assets)"
if [ -z "$CHANGED_LANDING" ]; then
  echo "· 랜딩(index.html/assets)은 그대로 → 랜딩 피그마 대조 건너뜀"
  echo "${DONE_MSG}"
  exit 0
fi

# node 가 없으면 피그마 덤프를 **요구하지도 않는다.** 요구해 봐야 돌릴 것이 없고,
# 못 돌리는 이유로 푸시를 막으면 --no-verify 로 6겹이 통째로 꺼진다.
if [ "$HAVE_NODE" = "0" ]; then
  echo "🔴 node 가 없어 랜딩 피그마 대조(2겹b)를 건너뜁니다. **CI 도 이건 못 봅니다** —"
  echo "   라이브 피그마 덤프가 필요해 CI 로 못 옮긴 유일한 검사입니다."
  echo "   index.html/assets 를 고쳤으니, node 가 있는 곳에서 한 번 대조하는 것이 좋습니다."
  echo "${DONE_MSG}"
  exit 0
fi

find_file() {
  local name="$1" env_val="$2"
  [ -n "$env_val" ] && [ -f "$env_val" ] && { echo "$env_val"; return; }
  for p in "$ROOT/$name" "$ROOT/../$name" "$HOME/$name"; do
    [ -f "$p" ] && { echo "$p"; return; }
  done
}

META="$(find_file figma_meta.xml "${FIGMA_META:-}")"
TYPE="$(find_file figma_type.json "${FIGMA_TYPE:-}")"
STYLE="$(find_file figma_style.json "${FIGMA_STYLE:-}")"

if [ -z "$META" ]; then
  fail <<'MSG'

✋ 푸시 중단 — 피그마 메타데이터(figma_meta.xml)를 찾지 못했습니다.

랜딩 결과물이 바뀌었는데 피그마와 대조하지 않은 상태입니다.
CLAUDE.md "랜딩을 건드렸다면 — 푸시 전에" 절차대로
  1) get_metadata → figma_meta.xml
  2) use_figma 타이포 스니펫 → figma_type.json
  3) use_figma 스타일 스니펫 → figma_style.json
를 만든 뒤 다시 푸시하세요.
MSG
fi

echo "▶ 피그마 대조 검수 실행…"
ARGS=("$META")
[ -n "$TYPE" ] && ARGS+=("$TYPE")
if [ -n "$STYLE" ]; then
  [ -z "$TYPE" ] && { echo "✋ figma_style.json 만 있고 figma_type.json 이 없습니다 — 인자 순서상 둘 다 필요합니다." >&2; exit 1; }
  ARGS+=("$STYLE")
fi
# 🔴 "경고" 가 아니다. audit.mjs 는 TYPE·STYLE 등급을 findings 로 올리고 그것으로 종료코드 1 을
#    낸다 — 바로 아래에서 확실히 막힌다. 안심시키는 문구를 쓰면 원인을 엉뚱한 데서 찾게 된다.
[ -z "$TYPE" ]  && echo "✋ figma_type.json 이 없습니다 — 타이포 대조를 못 해 아래에서 막힙니다." >&2
[ -z "$STYLE" ] && echo "✋ figma_style.json 이 없습니다 — 스타일 대조를 못 해 아래에서 막힙니다." >&2
node tools/figma-audit/audit.mjs "${ARGS[@]}"
STATUS=$?

if [ $STATUS -ne 0 ]; then
  fail <<'MSG'

✋ 푸시 중단 — 피그마 대조에서 조치 필요 항목이 나왔습니다.
위 목록을 피그마 기준으로 해결한 뒤 다시 푸시하세요.
MSG
fi

echo "${DONE_MSG}"
exit 0
