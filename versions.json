   "sections": [
    {
     "n": "첫 화면",
     "t": "하루 129원으로 연봉 300만원 올리기"
    },
    {
     "n": "직군 퀴즈",
     "t": "당신의 전문 분야에서 몇 개의 질문에 명확하게 대답할 수 있나요?"
    },
    {
     "n": "하루 1시간 절약",
     "t": "이젠 하루에 1시간씩 소비할 필요 없어요"
    },
    {
     "n": "걱정 마세요",
     "t": "하지만 걱정 마세요! ☺️"
    },
    {
     "n": "전문가 5줄 요약",
     "t": "각 분야 최고의 전문가들과 협업해 주제를 엄선하고, 5줄 요약을 작성해 드려요."
    },
    {
     "n": "아티클 전문",
     "t": "더 자세히 보고 싶은 날엔 상세 아티클 전문도 볼 수 있어요."
    },
    {
     "n": "카톡 열람률 6배",
     "t": "내 업계 지식과 인사이트가 무조건 늘어납니다."
    },
    {
     "n": "목요일 채용 브리핑",
     "t": "여기에 더해, 일주일에 한번은 최신 채용 공고, 채용 시장 트렌드까지 발송"
    },
    {
     "n": "조건 맞춤 공고",
     "t": "원하는 직군·연차·지역을 선택하면 최신 채용 공고를 매주 모아 보내줘요"
    },
    {
     "n": "기회 놓치지 마세요",
     "t": "이제는 관심 있는 회사 공고가 열린 지 모르고 기회를 놓치지 마세요."
    },
    {
     "n": "요일별 발송",
     "t": "요일별로 이렇게 보내드려요"
    },
    {
     "n": "CEO 의 코치",
     "t": "구글·애플·아마존의 CEO에게도 코치가 있었습니다"
    },
    {
     "n": "저 사람은 어떻게",
     "t": "\"저 사람은 어떻게 다 알고 있지?\""
    },
    {
     "n": "구독자 수 띠",
     "t": "13,205 명은 이미 더 앞서가는 중"
    },
    {
     "n": "요금",
     "t": "하루 129원 투자로 연봉 · 커리어를 상승시키세요"
    },
    {
     "n": "연봉 1% 효과",
     "t": "연봉 협상에서 1%만 추가 인상돼도 1년 구독료의 8.5배"
    },
    {
     "n": "1년 250개",
     "t": "1년에 250개의 인사이트를 더 쌓은 만큼 역량 상승과 연봉 추가 인상은 당연하죠"
    },
    {
     "n": "구독자 후기",
     "t": "생생한 구독자 후기"
    },
    {
     "n": "자주 묻는 질문",
     "t": "자주 묻는 질문"
    },
    {
     "n": "마지막 · 아침 8시",
     "t": "당장 내일부터 내 연봉이 올라가는 카카오톡을 아침 8시마다 받아보세요."
    }
   ],
