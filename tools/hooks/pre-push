#!/usr/bin/env bash
# 푸시 전 검수 훅 — 두 겹으로 막는다.
#
#   1겹 · 결과물 공통 점검 (page-audit.mjs) — 항상 돈다
#       저장소의 모든 *.html + CNAME + assets 를 본다. 새 페이지를 추가해도
#       설정을 고칠 필요 없이 자동으로 대상에 들어온다. 외부 준비물이 없어
#       어느 세션에서든 무조건 실행된다.
#
#   2겹 · 피그마 대조 (audit.mjs) — index.html / assets 가 바뀐 푸시에만 돈다
#       기준 프레임(6:148)이 있는 랜딩만 해당. 피그마 덤프 3개(메타/타이포/스타일)가 필요하다.
#
#   0겹 · 배포 쿨다운 — 직전 푸시 직후의 연속 푸시를 막는다 (아래 상세)
#
# 설치 (클론한 세션에서 한 줄):
#   git config core.hooksPath tools/hooks
#
# 피그마 덤프 세 개를 찾는 순서:
#   1) 환경변수 FIGMA_META / FIGMA_TYPE / FIGMA_STYLE
#   2) 저장소 루트의 figma_meta.xml / figma_type.json / figma_style.json
#   3) 상위 디렉터리(/home/claude 등)의 같은 이름 파일
#
# 급할 때만: git push --no-verify

set -u
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 0

fail() {
  cat >&2
  echo "(정말 급하면: git push --no-verify)" >&2
  exit 1
}

# ───────────────────────────────────────────────────
# 0겹 — 배포 쿨다운 (연속 푸시로 앞 배포를 죽이지 않도록)
#
# GitHub Pages 는 [푸시 → 빌드 → 배포] 3단계고, 같은 브랜치에 새 푸시가 들어오면
# 진행 중이던 실행을 "higher priority waiting request" 로 **취소**한다.
# 2026-08-02 에 30분 동안 다섯 번 푸시했더니 앞의 네 개가 전부 취소돼,
# 이미 고친 버그가 라이브에 한 시간 넘게 안 올라갔다.
#
# 그래서 직전 푸시로부터 CC_PUSH_COOLDOWN 초가 지나기 전에는 푸시를 막는다.
# "직전 푸시 시각" 은 origin/main 최신 커밋의 커밋 시각으로 근사한다(세션이 달라도 통한다).
#
#   조절:  CC_PUSH_COOLDOWN=<초> git push …    (0 이면 쿨다운만 끔, 검수는 그대로 돈다)
#   기본:  900초(15분)
# ───────────────────────────────────────────────────
COOLDOWN="${CC_PUSH_COOLDOWN:-900}"
if [ "$COOLDOWN" -gt 0 ] 2>/dev/null; then
  git fetch -q origin main 2>/dev/null || true
  LAST="$(git log -1 --format=%ct origin/main 2>/dev/null || echo '')"
  if [ -n "$LAST" ]; then
    NOW="$(date +%s)"
    ELAPSED=$(( NOW - LAST ))
    if [ "$ELAPSED" -ge 0 ] && [ "$ELAPSED" -lt "$COOLDOWN" ]; then
      WAIT=$(( COOLDOWN - ELAPSED ))
      {
        echo ""
        echo "✋ 푸시 중단 — 직전 푸시가 $(( ELAPSED / 60 ))분 $(( ELAPSED % 60 ))초 전입니다."
        echo ""
        echo "GitHub Pages 배포가 아직 진행 중일 수 있습니다. 지금 푸시하면 그 배포가"
        echo "취소되고(higher priority waiting request) 큐를 처음부터 다시 탑니다."
        echo "결과적으로 라이브 반영이 더 늦어집니다."
        echo ""
        echo "  → 약 $(( (WAIT + 59) / 60 ))분 뒤에 다시 푸시하세요."
        echo "  → 그동안 커밋을 더 쌓아 두면 한 번에 나갑니다 (그게 가장 빠릅니다)."
        echo "  → 확인만 급하면 미리보기로: node tools/make-preview.mjs"
        echo ""
        echo "정말 지금 나가야 하면 (검수는 그대로 돕니다):"
        echo "  CC_PUSH_COOLDOWN=0 git push origin main"
        echo ""
      } >&2
      exit 1
    fi
  fi
fi

# ───────────────────────────────────────────────────
# 1겹 — 결과물 공통 점검 (항상)
# ───────────────────────────────────────────────────
echo "▶ 결과물 공통 점검…"
if ! node tools/figma-audit/page-audit.mjs; then
  fail <<'MSG'

✋ 푸시 중단 — 결과물 공통 점검에서 조치 필요 항목이 나왔습니다.
깨진 링크·빠진 head·자리표시자·태그 불균형은 배포되면 바로 드러납니다.
위 "❌ 막힘" 항목을 고친 뒤 다시 푸시하세요.
MSG
fi

# ───────────────────────────────────────────────────
# 1.2겹 — 피그마 트리 점검 (tree-audit.mjs) — 항상 돈다
#
#   "섹션 밖으로 튀어나간 고아 노드" 를 잡는 유일한 검사다.
#   2026-08-08 에 프레임 626:2657 이 섹션 625:2657 밖으로 나가 캔버스에 떠 있었는데
#   검수 여섯 종이 전부 통과했다 — 나머지는 방향이 '웹 → 피그마' 이거나 프레임 안쪽만 본다.
#
#   덤프 없이도 돈다(등록부 ↔ 트리 스냅샷 정합성). 라이브 고아 노드까지 보려면
#   figma_tree.json 을 준다 — 찾는 순서는 아래 2겹의 덤프와 같다.
#   등록부나 트리 스냅샷을 건드린 푸시에는 덤프를 **요구**한다(그때가 어긋나기 제일 쉬운 순간이라).
# ───────────────────────────────────────────────────
echo "▶ 피그마 트리 점검 (고아 노드)…"
TREE=""
for p in "${FIGMA_TREE:-}" "$ROOT/figma_tree.json" "$ROOT/../figma_tree.json" "$HOME/figma_tree.json"; do
  [ -n "$p" ] && [ -f "$p" ] && { TREE="$p"; break; }
done

TREE_BASE="$(git rev-parse --verify -q origin/main 2>/dev/null || echo '')"
if [ -n "$TREE_BASE" ]; then
  CHANGED_TREE="$(git diff --name-only "$TREE_BASE"..HEAD -- tools/figma-audit/page-figma-map.json tools/figma-audit/figma-tree.json 2>/dev/null)"
else
  CHANGED_TREE="unknown"
fi

if [ -z "$TREE" ] && [ -n "$CHANGED_TREE" ]; then
  fail <<'MSG'

✋ 푸시 중단 — 피그마 등록부/트리 스냅샷을 바꿨는데 라이브 피그마와 대조하지 않았습니다.

tools/figma-audit/README.md "피그마 트리 덤프" 스니펫을 use_figma 로 돌려
figma_tree.json 으로 저장한 뒤 다시 푸시하세요. (섹션 밖으로 나간 노드를 여기서 잡습니다)
MSG
fi

if ! node tools/figma-audit/tree-audit.mjs ${TREE:+"$TREE"}; then
  fail <<'MSG'

✋ 푸시 중단 — 피그마 안에서 노드가 섹션 밖으로 나갔거나, 등록부와 트리 스냅샷이 어긋났습니다.
위 "❌ 막힘" 을 피그마에서 되돌린 뒤(섹션 안으로 옮기기) 다시 푸시하세요.
섹션의 자식은 x/y 가 섹션 기준 상대좌표입니다 — 좌표만 맞추고 부모를 확인하지 않으면
숫자는 맞는데 캔버스 저편에 떠 있는 상태가 됩니다.
MSG
fi

# ───────────────────────────────────────────────────
# 1.5겹 — 온보딩 직군 목록이 taxonomy.json 에서 생성된 그대로인가
#   손으로 고치면 code(직행 조회 표기)와 label(화면 표기)이 조용히 어긋난다.
# ───────────────────────────────────────────────────
echo "▶ 온보딩 직군 목록 ↔ taxonomy.json 대조…"
if ! node tools/roles/build.mjs --check; then
  fail <<'MSG'

✋ 푸시 중단 — 온보딩 1단계 직군 목록이 tools/roles/taxonomy.json 과 다릅니다.
목록은 taxonomy.json 이 기준이고 HTML 은 파생물입니다.
  node tools/roles/build.mjs
를 돌려 다시 만든 뒤 커밋하세요. (문구·분류를 바꾸려면 taxonomy.json 을 고칩니다)
MSG
fi

# ───────────────────────────────────────────────────
# 2겹 — 피그마 대조
#   (a) 약관·개인정보 화면 (docs-audit.mjs) — terms/privacy.html 또는 스냅샷이 바뀐 푸시.
#       커밋된 스냅샷(figma-docs-text.json)과 문구를 대조하므로 라이브 피그마 덤프가 필요 없다.
#   (b) 랜딩 (audit.mjs) — index.html/assets 가 바뀐 푸시. 피그마 덤프 3개가 필요하다.
# ───────────────────────────────────────────────────
RANGE_BASE="$(git rev-parse --verify -q origin/main 2>/dev/null || echo '')"
diff_names() {
  if [ -n "$RANGE_BASE" ]; then git diff --name-only "$RANGE_BASE"..HEAD -- "$@" 2>/dev/null
  else printf '%s\n' "$@"; fi   # origin/main 을 모르면 안전하게 '바뀐 것'으로 취급
}

# (a) 문서·가입·온보딩 화면 ↔ 피그마 문구 동기화
#   대상 파일을 손으로 나열하지 않는다 — 2026-08-07 에 그 목록이 낡아서
#   signup/onboarding 이 대조 대상에서 빠져 있었다(같은 종류의 사고가 두 번 났다).
#   HTML 이 하나라도 바뀌었으면 돌린다. 브라우저·피그마 덤프가 필요 없어 싸다.
CHANGED_DOCS="$(diff_names '*.html' tools/figma-audit/figma-docs-text.json tools/figma-audit/page-figma-map.json)"
if [ -n "$CHANGED_DOCS" ]; then
  echo "▶ 약관·개인정보 화면 ↔ 피그마 문구 대조…"
  if ! node tools/figma-audit/docs-audit.mjs; then
    fail <<'MSG'

✋ 푸시 중단 — 약관·개인정보 화면이 피그마와 어긋났습니다.
웹과 피그마 중 한쪽만 문구를 고치면 납니다.
  · 웹을 고쳤으면 → 피그마 화면(섹션 327:2474)도 같은 문구로 고치고, 스냅샷을 다시 뽑아 커밋하세요.
  · 피그마를 고쳤으면 → 웹(terms/privacy.html)을 맞추고, 스냅샷을 다시 뽑아 커밋하세요.
스냅샷 다시 뽑기: CLAUDE.md "약관·개인정보 화면 — 피그마↔웹 동기화" 참고.
MSG
  fi
fi

# (b) 랜딩 대조 (index.html/assets 가 바뀐 푸시만)
CHANGED_LANDING="$(diff_names index.html assets)"
if [ -z "$CHANGED_LANDING" ]; then
  echo "· 랜딩(index.html/assets)은 그대로 → 랜딩 피그마 대조 건너뜀"
  echo "✅ 검수 통과 — 푸시합니다."
  exit 0
fi

find_file() {
  local name="$1" env_val="$2"
  [ -n "$env_val" ] && [ -f "$env_val" ] && { echo "$env_val"; return; }
  for p in "$ROOT/$name" "$ROOT/../$name" "$HOME/$name"; do
    [ -f "$p" ] && { echo "$p"; return; }
  done
}

META="$(find_file figma_meta.xml "${FIGMA_META:-}")"
TYPE="$(find_file figma_type.json "${FIGMA_TYPE:-}")"
STYLE="$(find_file figma_style.json "${FIGMA_STYLE:-}")"

if [ -z "$META" ]; then
  fail <<'MSG'

✋ 푸시 중단 — 피그마 메타데이터(figma_meta.xml)를 찾지 못했습니다.

랜딩 결과물이 바뀌었는데 피그마와 대조하지 않은 상태입니다.
CLAUDE.md "랜딩을 건드렸다면 — 푸시 전에" 절차대로
  1) get_metadata → figma_meta.xml
  2) use_figma 타이포 스니펫 → figma_type.json
  3) use_figma 스타일 스니펫 → figma_style.json
를 만든 뒤 다시 푸시하세요.
MSG
fi

echo "▶ 피그마 대조 검수 실행…"
ARGS=("$META")
[ -n "$TYPE" ] && ARGS+=("$TYPE")
if [ -n "$STYLE" ]; then
  [ -z "$TYPE" ] && { echo "✋ figma_style.json 만 있고 figma_type.json 이 없습니다 — 인자 순서상 둘 다 필요합니다." >&2; exit 1; }
  ARGS+=("$STYLE")
fi
[ -z "$TYPE" ]  && echo "⚠️ figma_type.json 이 없어 타이포 신선도는 확인하지 못합니다." >&2
[ -z "$STYLE" ] && echo "⚠️ figma_style.json 이 없어 스타일 신선도는 확인하지 못합니다." >&2
node tools/figma-audit/audit.mjs "${ARGS[@]}"
STATUS=$?

if [ $STATUS -ne 0 ]; then
  fail <<'MSG'

✋ 푸시 중단 — 피그마 대조에서 조치 필요 항목이 나왔습니다.
위 목록을 피그마 기준으로 해결한 뒤 다시 푸시하세요.
MSG
fi

echo "✅ 검수 통과 — 푸시합니다."
exit 0
